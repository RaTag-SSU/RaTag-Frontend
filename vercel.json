{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.ratag.site/api/:path*"
    },
    {
      "source": "/oauth2/:path*",
      "destination": "https://api.ratag.site/oauth2/:path*"
    },
    {
      "source": "/login/oauth2/:path*",
      "destination": "https://api.ratag.site/login/oauth2/:path*"
    }
  ]
}
